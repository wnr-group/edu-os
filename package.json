{
  "name": "multi-tenant-erp",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:proxy": "docker run --rm --name erp-proxy -p 80:80 -v \"$(pwd)/Caddyfile\":/etc/caddy/Caddyfile caddy:2-alpine",
    "dev:full": "pnpm dev:proxy & pnpm dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test:db": "for f in supabase/tests/*.test.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "playwright": "^1.62.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "react-native-worklets": "~0.7.0"
    }
  }
}
